FROM node:22-bookworm-slim

# 1. Install FFmpeg, subtitle fonts, and OpenSSL
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    fonts-liberation \
    fonts-dejavu-core \
    openssl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 2. Copy root and workspace package files
COPY package*.json ./
COPY apps/worker/package.json ./apps/worker/package.json
COPY packages/database ./packages/database

# 3. Dummy URL so Prisma postinstall succeeds during build
ENV DATABASE_URL="postgresql://dummy:dummy@localhost:5432/dummy"

# 4. Explicitly install all dependencies for the worker workspace and root
RUN npm install --no-package-lock --workspace=apps/worker --include-workspace-root

# 5. Copy worker source code
COPY apps/worker ./apps/worker

# 6. Generate Prisma Client
RUN npx prisma generate --schema=packages/database/prisma/schema.prisma

# 7. Start the worker
CMD ["npm", "run", "start", "--workspace=apps/worker"]